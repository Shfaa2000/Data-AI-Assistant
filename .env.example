# مفتاح Gemini المطلوب للاستدعاءات الحقيقية.
GEMINI_API_KEY=

# إعدادات BigQuery.
GOOGLE_CLOUD_PROJECT=data-ai-assistant-training
FINOPS_DATASET_ID=cloud_finops
FINOPS_TABLE_ID=billing_pipeline_day2
BIGQUERY_LOCATION=US

# نموذج Gemini المستخدم.
GEMINI_MODEL=gemini-3.5-flash-lite

# يبقى false افتراضيًا لمنع التنفيذ غير المقصود.
FINOPS_EXECUTE_QUERIES=false

# الحد الأعلى لمعالجة البيانات: 100 MiB.
FINOPS_MAXIMUM_BYTES_BILLED=104857600

# الحد الأعلى لعدد صفوف النتيجة.
FINOPS_MAX_RESULT_ROWS=100

# أقصى مدة انتظار لتنفيذ الاستعلام بالثواني.
FINOPS_QUERY_TIMEOUT_SECONDS=60